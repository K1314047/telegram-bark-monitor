# =========================
# Telegram API
# =========================
# Get these from https://my.telegram.org -> API development tools
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Phone number used by the Telegram account, international format
TG_PHONE=+81xxxxxxxxxx

# =========================
# Bark
# =========================
# Example:
# BARK_URL=https://api.day.app
# If you run your own Bark server, change this.
BARK_URL=https://api.day.app
BARK_KEY=your_bark_device_key_here

# Optional: Bark sound/icon/group
BARK_SOUND=telegraph
BARK_GROUP=Telegram
BARK_LEVEL=active

# =========================
# Telegram channels
# =========================
# One per line, comma separated, or JSON-like is not required.
# Public channels can use @username.
# Private channels can be configured by numeric ID after the account has joined them.
CHANNELS=@example_channel,@example_channel_2

# =========================
# Keyword filtering
# =========================
# FILTER_MODE:
#   all     = every new message from monitored channels
#   keyword = only messages containing at least one keyword
FILTER_MODE=keyword

# Case-insensitive keywords, separated by commas.
KEYWORDS=Alpha,空投,活动,免费,白嫖,送,抽奖

# If true, matching is substring based.
KEYWORD_CASE_INSENSITIVE=true

# =========================
# Deduplication
# =========================
DEDUP_ENABLED=true
DEDUP_TTL_SECONDS=604800

# SQLite database
DB_PATH=/app/data/monitor.db

# =========================
# Optional Telegram SOCKS5 proxy
# =========================
# Useful if the Docker host/container cannot reach Telegram directly.
# Format examples:
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
# TELEGRAM_PROXY=socks5://user:password@host:port
TELEGRAM_PROXY=

# =========================
# Logging
# =========================
LOG_LEVEL=INFO
